<Application x:Class="NoteTaker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:NoteTaker.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Tokens.xaml" />
                <ResourceDictionary Source="Theme/Icons.xaml" />
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
            <conv:BooleanToVisibilityConverter x:Key="BoolToVisible" />
            <conv:InverseBooleanToVisibilityConverter x:Key="BoolToCollapsed" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

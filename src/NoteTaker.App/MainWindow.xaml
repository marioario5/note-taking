<Window x:Class="NoteTaker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:NoteTaker.App.ViewModels"
        xmlns:controls="clr-namespace:NoteTaker.App.Controls"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="NoteTaker" Height="900" Width="1500"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource FontUi}"
        Foreground="{StaticResource TextBody}"
        Background="{StaticResource SurfaceChrome}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame" Background="{StaticResource SurfaceChrome}">
        <DockPanel>
            <!-- ══ Header: one slim strip carrying the menus, the ink tools and the mode ══ -->
            <!-- 38 = the 32px mode-segment track plus 3px of air above and below, so the
                 pill's rounded ends aren't pressed against the header edges. -->
            <Grid x:Name="HeaderBar" DockPanel.Dock="Top" Background="{StaticResource HeaderWash}" MinHeight="38">
                <!-- Sparse scatter of stars behind the header content, exactly as the mockup
                     places it first (bottom of z-order) inside the header strip. Hidden on the
                     landing screen: with the toolbar gone the stars are all that is left of the
                     header, and a scatter of dots over nothing reads as dirt on the glass. -->
                <controls:StarfieldDecoration x:Name="HeaderStars" Count="6" Seed="21" Density="sparse" />

                <!-- Takes the stars' place while the landing screen is up. Anchored right and
                     drawn faint, so the header has a considered edge instead of a bare strip. -->
                <Canvas x:Name="HeaderOrnament" Width="300" Height="38" ClipToBounds="True"
                        HorizontalAlignment="Right" Visibility="Collapsed" Opacity="0.5">
                    <Canvas.Resources>
                        <Style TargetType="Line">
                            <Setter Property="Stroke" Value="{StaticResource TextFaint}" />
                            <Setter Property="StrokeThickness" Value="1" />
                        </Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Stroke" Value="{StaticResource TextFaint}" />
                            <Setter Property="StrokeThickness" Value="1" />
                            <Setter Property="Width" Value="5" />
                            <Setter Property="Height" Value="5" />
                        </Style>
                    </Canvas.Resources>
                    <Line X1="10" Y1="12" X2="150" Y2="12" />
                    <Line X1="150" Y1="12" X2="168" Y2="26" />
                    <Line X1="168" Y1="26" X2="292" Y2="26" />
                    <Line X1="60" Y1="26" X2="140" Y2="26" />
                    <Line X1="196" Y1="12" X2="292" Y2="12" />
                    <Line X1="196" Y1="12" X2="184" Y2="4" />
                    <Ellipse Canvas.Left="146" Canvas.Top="9" />
                    <Ellipse Canvas.Left="56" Canvas.Top="23" />
                    <Ellipse Canvas.Left="193" Canvas.Top="9" />
                </Canvas>
                <!-- The landing screen's own header content, where the toolbar would be:
                     who you are in the app, which subject you are looking at, and one click
                     back into the page you were last writing on. Collapsed in the notebook,
                     where the toolbar owns this strip. -->
                <StackPanel x:Name="HeaderLanding" Orientation="Horizontal" Margin="18,0,0,0"
                            VerticalAlignment="Center" Visibility="Collapsed"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <controls:Icon Geometry="{StaticResource IconFeather}" Width="14" Height="14"
                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="NoteTaker" Margin="9,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource FontShell}" FontWeight="SemiBold"
                               FontSize="13" Foreground="{StaticResource TextBody}" />
                    <TextBlock x:Name="HeaderSubject" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontFamily="{StaticResource FontShell}" FontSize="13"
                               Foreground="{StaticResource TextFaint}" />
                    <Button x:Name="HeaderResume" Margin="18,0,0,0" Padding="12,4"
                            VerticalAlignment="Center" Visibility="Collapsed"
                            FontFamily="{StaticResource FontShell}" FontSize="12.5"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>

                <Border Width="3" HorizontalAlignment="Left" CornerRadius="0,3,3,0"
                        Background="{StaticResource AccentStripe}" />
                <Border BorderBrush="{StaticResource BorderNightSoft}" BorderThickness="0,0,0,1" />

                <DockPanel Margin="11,0,0,0" LastChildFill="True">
                    <!-- Window buttons. Hit-testable so they win over the drag caption. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                                ToolTip="Minimise">
                            <controls:Icon Geometry="{StaticResource IconMinus}" Width="14" Height="14"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <!-- Icon and tooltip follow the window state, so the button says which
                             way it will go. Driven off WindowState rather than set in the click
                             handler, because the state also changes without us: the on-screen
                             keyboard un-maximizes the window, and MaximizeGuard puts it back. -->
                        <Button x:Name="MaximizeButton">
                            <controls:Icon Width="12" Height="12"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}">
                                <!-- BasedOn is load-bearing: an Icon style without it replaces
                                     the implicit one, taking the ControlTemplate with it, and
                                     the button renders as an empty gap. -->
                                <controls:Icon.Style>
                                    <Style TargetType="controls:Icon"
                                           BasedOn="{StaticResource {x:Type controls:Icon}}">
                                        <Setter Property="Geometry" Value="{StaticResource IconSquare}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState,
                                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="Maximized">
                                                <Setter Property="Geometry" Value="{StaticResource IconRestore}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </controls:Icon.Style>
                            </controls:Icon>
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                                    <Setter Property="ToolTip" Value="Maximise" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState,
                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                     Value="Maximized">
                                            <Setter Property="ToolTip" Value="Restore down" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" ToolTip="Close">
                            <controls:Icon Geometry="{StaticResource IconX}" Width="14" Height="14"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </StackPanel>

                    <!-- Tutor mode segments sit hard right of the tools. -->
                    <Border x:Name="ModeSegments" DockPanel.Dock="Right" Style="{StaticResource SegmentTrack}"
                            VerticalAlignment="Center" Margin="12,0,14,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeLive" Content="Live" IsChecked="True"
                                         Style="{StaticResource SegmentButton}"
                                         ToolTip="He reads the page a couple of seconds after you pause." />
                            <!-- Practice is not here any more. With page checking gone, Live and
                                 Practice differ only in whether the tutor panel is sealed, which
                                 is a rare deliberate choice rather than a thing to flip between
                                 while writing — so it moved to the Tutor menu and the header kept
                                 the two modes that change what the sidebar is for. -->
                            <RadioButton x:Name="ModePractice" Visibility="Collapsed"
                                         Content="Practice"
                                         Style="{StaticResource SegmentButton}"
                                         ToolTip="Nothing read, nothing sent." />
                            <RadioButton x:Name="ModeReview" Content="Review"
                                         Style="{StaticResource SegmentButton}"
                                         ToolTip="No live checks; review the page when you are ready." />
                        </StackPanel>
                    </Border>

                    <!-- 6-day activity sparkline; ToolTip and bars filled in from ApiUsageLog
                         by RefreshStreakAsync (MainWindow.xaml.cs). -->
                    <StackPanel x:Name="StreakStrip" DockPanel.Dock="Right" Orientation="Horizontal"
                                VerticalAlignment="Center" Height="14" Margin="10,0,0,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True" />

                    <!-- Everything that only makes sense with a page open. Collapsed while the
                         landing view is showing, the way OneNote's File tab replaces the ribbon
                         rather than sitting under it. -->
                    <StackPanel x:Name="ToolbarMain" Orientation="Horizontal" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <ToggleButton x:Name="NavToggle" Margin="0,0,7,0" ToolTip="Show notebooks"
                                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <controls:Icon Geometry="{StaticResource IconPanelRight}" Width="15" Height="15"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=ToggleButton}}">
                                <controls:Icon.RenderTransform>
                                    <ScaleTransform ScaleX="-1" />
                                </controls:Icon.RenderTransform>
                                <controls:Icon.RenderTransformOrigin>0.5,0.5</controls:Icon.RenderTransformOrigin>
                            </controls:Icon>
                        </ToggleButton>

                        <!-- Where you are, and the way in to the tree. Nothing else in the
                             notebook names the open lesson: the window title carries it, but the
                             custom chrome never draws one. Clicking it toggles the tree, which
                             puts "see where I am" and "go somewhere else" on the same target
                             rather than behind an icon nobody finds. -->
                        <!-- Capped and trimmed. Uncapped, a long lesson name ("5.5 Triple
                             Integrals in Cylindrical and Spherical Coordinates") stretched this
                             button far enough to push the tutor toggle off the right edge of the
                             toolbar, which read as the button having disappeared. -->
                        <Button x:Name="PageCrumb" Margin="0,0,4,0" Padding="9,4"
                                Style="{StaticResource RowButton}"
                                HorizontalAlignment="Left" FontSize="12.5" MaxWidth="230"
                                ToolTip="Show the notebook tree"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock x:Name="PageCrumbText" TextTrimming="CharacterEllipsis" />
                        </Button>
                        <Menu VerticalAlignment="Center">
                            <MenuItem Header="_File">
                                <MenuItem x:Name="MenuHome" Header="Home" InputGestureText="Ctrl H" />
                                <Separator />
                                <MenuItem x:Name="MenuNewNotebook" Header="New notebook" />
                                <MenuItem x:Name="MenuNewSection" Header="New section" />
                                <MenuItem x:Name="MenuNewPage" Header="New page" InputGestureText="Ctrl N" />
                                <Separator />
                                <MenuItem x:Name="MenuImportPdf" Header="Attach a PDF to this page…" />
                                <Separator />
                                <MenuItem x:Name="MenuExportPng" Header="Export as PNG…" />
                                <MenuItem x:Name="MenuExportPdf" Header="Export as PDF…" />
                                <MenuItem x:Name="MenuExportSvg" Header="Export as SVG…" />
                                <Separator />
                                <MenuItem x:Name="MenuExit" Header="Exit" />
                            </MenuItem>
                            <MenuItem Header="_Edit">
                                <MenuItem x:Name="MenuUndo" Header="Undo stroke" InputGestureText="Ctrl Z" />
                                <MenuItem x:Name="MenuRedo" Header="Redo" InputGestureText="Ctrl Y" />
                                <Separator />
                                <MenuItem x:Name="MenuPasteImage" Header="Paste a picture"
                                          InputGestureText="Ctrl V"
                                          ToolTip="Drops a picture onto the page. The tutor reads it in chat, but won't mark it up." />
                                <Separator />
                                <MenuItem x:Name="MenuRenamePage" Header="Rename this page…" />
                                <MenuItem x:Name="MenuDeletePage" Header="Delete this page" />
                            </MenuItem>
                            <MenuItem Header="_Page">
                                <MenuItem x:Name="MenuZoomIn" Header="Zoom in" InputGestureText="Ctrl +" />
                                <MenuItem x:Name="MenuZoomOut" Header="Zoom out" InputGestureText="Ctrl -" />
                                <MenuItem x:Name="MenuZoomFit" Header="Fit the page" InputGestureText="Ctrl 0" />
                                <Separator />
                                <MenuItem x:Name="MenuSplitView" Header="Split view" IsCheckable="True" />
                                <MenuItem x:Name="MenuRuled" Header="Ruled ground" IsCheckable="True" />
                            </MenuItem>
                            <MenuItem Header="_Tutor">
                                <MenuItem x:Name="MenuReviewPage" Header="Check the page now" InputGestureText="F5" />
                                <MenuItem x:Name="MenuSessionReport" Header="Session pattern report…" />
                                <MenuItem x:Name="MenuFlushQueue" Header="Send queued checks" />
                                <Separator />
                                <MenuItem x:Name="MenuShowAside" Header="Show the tutor panel" IsCheckable="True"
                                          IsChecked="False" InputGestureText="Ctrl T" />
                                <MenuItem x:Name="MenuPracticeMode" Header="Practice mode" IsCheckable="True"
                                          IsChecked="False"
                                          ToolTip="Seals the tutor panel. Nothing is read and nothing is sent." />
                                <MenuItem x:Name="MenuInkTrace" Header="Save ink trace now"
                                          ToolTip="Tracing runs the whole time. This writes what has been captured so far; closing the app writes it too." />
                                <MenuItem x:Name="MenuInkProbes" Header="Record input timing" IsCheckable="True"
                                          IsChecked="False"
                                          ToolTip="Adds stall and UI-thread timing to the trace. Off by default: these probes poll the dispatcher, so they are kept out of the pen path unless you are measuring latency." />
                                <MenuItem x:Name="MenuUsage" Header="Usage and cost…" />
                            </MenuItem>
                            <MenuItem Header="_Study">
                                <MenuItem x:Name="MenuSearch" Header="Find across pages…" InputGestureText="Ctrl F" />
                                <MenuItem x:Name="MenuRelated" Header="Related pages" />
                                <MenuItem x:Name="MenuPractice" Header="Generate practice…" />
                                <MenuItem x:Name="MenuReindex" Header="Rebuild the search index" />
                            </MenuItem>
                            <MenuItem Header="_Tools">
                                <MenuItem x:Name="MenuGraph" Header="Insert a graph…" />
                                <MenuItem x:Name="MenuCode" Header="Insert a Python cell…" />
                                <Separator />
                                <MenuItem x:Name="MenuBenchmark" Header="Ink benchmark…" />
                                <MenuItem x:Name="MenuSettings" Header="Settings…" />
                            </MenuItem>
                        </Menu>

                        <Border Width="1" Height="14" Margin="9,0"
                                Background="{StaticResource BorderNight}" />

                        <RadioButton x:Name="ToolPen" Style="{StaticResource ToolToggle}"
                                     IsChecked="True" GroupName="Tool" ToolTip="Pen">
                            <controls:Icon Geometry="{StaticResource IconPenTool}" Width="15" Height="15"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>
                        <RadioButton x:Name="ToolHighlighter" Style="{StaticResource ToolToggle}"
                                     GroupName="Tool" ToolTip="Highlighter">
                            <controls:Icon Geometry="{StaticResource IconHighlighter}" Width="15" Height="15"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>
                        <RadioButton x:Name="ToolEraser" Style="{StaticResource ToolToggle}"
                                     GroupName="Tool" ToolTip="Eraser">
                            <controls:Icon Geometry="{StaticResource IconEraser}" Width="15" Height="15"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>
                        <RadioButton x:Name="ToolSelect" Style="{StaticResource ToolToggle}"
                                     GroupName="Tool"
                                     ToolTip="Stop inking so you can tap a finding">
                            <controls:Icon Geometry="{StaticResource IconMousePointer2}" Width="15" Height="15"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>

                        <Border Width="1" Height="14" Margin="9,0"
                                Background="{StaticResource BorderNight}" />

                        <StackPanel x:Name="SwatchStrip" Orientation="Horizontal"
                                    VerticalAlignment="Center" />

                        <Slider x:Name="WidthSlider" Width="72" Minimum="1" Maximum="12" Value="1.5"
                                Margin="10,0,0,0" VerticalAlignment="Center"
                                ToolTip="Stroke width" />

                        <Border Width="1" Height="14" Margin="9,0"
                                Background="{StaticResource BorderNight}" />

                        <Button x:Name="UndoButton" Style="{StaticResource IconButton}" ToolTip="Undo">
                            <controls:Icon Geometry="{StaticResource IconUndo2}" Width="15" Height="15"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="RedoButton" Style="{StaticResource IconButton}" ToolTip="Redo">
                            <controls:Icon Geometry="{StaticResource IconRedo2}" Width="15" Height="15"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="GraphButton" Style="{StaticResource IconButton}" ToolTip="Insert a graph">
                            <controls:Icon Geometry="{StaticResource IconChartSpline}" Width="15" Height="15"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="CodeButton" Style="{StaticResource IconButton}"
                                ToolTip="Insert a Python cell">
                            <controls:Icon Geometry="{StaticResource IconSquareTerminal}" Width="15" Height="15"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>

                        <Border Width="1" Height="14" Margin="9,0"
                                Background="{StaticResource BorderNight}" />

                        <Button x:Name="ZoomOutButton" Style="{StaticResource IconButton}" ToolTip="Zoom out">
                            <controls:Icon Geometry="{StaticResource IconZoomOut}" Width="15" Height="15"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <TextBlock x:Name="ZoomLabel" Text="100%" Width="42" TextAlignment="Center"
                                   VerticalAlignment="Center" Style="{StaticResource Mono}" />
                        <Button x:Name="ZoomInButton" Style="{StaticResource IconButton}" ToolTip="Zoom in">
                            <controls:Icon Geometry="{StaticResource IconZoomIn}" Width="15" Height="15"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                        <Button x:Name="ZoomFitButton" Style="{StaticResource IconButton}" ToolTip="Fit the page">
                            <controls:Icon Geometry="{StaticResource IconMaximize}" Width="15" Height="15"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>

                        <Border Width="1" Height="14" Margin="9,0"
                                Background="{StaticResource BorderNight}" />

                        <!-- Set apart from the zoom cluster on purpose: unlike its
                             neighbors this opens the whole tutor experience, not just an
                             adjustment to the current view — Ctrl+T also reaches it. -->
                        <ToggleButton x:Name="AsideToggle" IsChecked="False"
                                      ToolTip="Show the tutor panel (Ctrl+T)">
                            <controls:Icon Geometry="{StaticResource IconPanelRight}" Width="15" Height="15"
                                           Foreground="{Binding Foreground,
                                               RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                        </ToggleButton>
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- ══ Notice bars ══ -->
            <StackPanel x:Name="NoticeHost" DockPanel.Dock="Top">
                <Border x:Name="KeyNotice" Visibility="Collapsed" Padding="18,10"
                        Background="{StaticResource AccentTint}"
                        BorderBrush="{StaticResource BorderNightSoft}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button x:Name="AddKeyButton" DockPanel.Dock="Right" Content="Add a key"
                                Style="{StaticResource AccentGhostButton}" />
                        <controls:Icon Geometry="{StaticResource IconTriangleAlert}" Width="16" Height="16"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                        <TextBlock Margin="11,0" VerticalAlignment="Center"
                                   Text="No key yet, so the tutor can't read your page. Everything else works." />
                    </DockPanel>
                </Border>

                <Border x:Name="OfflineNotice" Visibility="Collapsed" Padding="18,10"
                        Background="{StaticResource DangerTint}"
                        BorderBrush="{StaticResource BorderNightSoft}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <controls:Icon Geometry="{StaticResource IconCloudOff}" Width="16" Height="16"
                                       Foreground="{StaticResource Major}" VerticalAlignment="Center" />
                        <TextBlock Margin="11,0" VerticalAlignment="Center"
                                   Text="Offline. Your ink is safe on this machine — checks will resume when you're back." />
                    </DockPanel>
                </Border>

                <Border x:Name="BudgetNotice" Visibility="Collapsed" Padding="18,10"
                        Background="{StaticResource AccentTint}"
                        BorderBrush="{StaticResource BorderNightSoft}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button x:Name="RaiseLimitButton" DockPanel.Dock="Right" Content="Raise the limit"
                                Style="{StaticResource AccentGhostButton}" />
                        <controls:Icon Geometry="{StaticResource IconGauge}" Width="16" Height="16"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                        <TextBlock Margin="11,0" VerticalAlignment="Center"
                                   Text="You've used today's tutoring budget. Keep writing — checks pick up tomorrow." />
                    </DockPanel>
                </Border>

                <Border x:Name="PracticeNotice" Visibility="Collapsed" Padding="18,10"
                        Background="{StaticResource SurfaceSunk}"
                        BorderBrush="{StaticResource BorderNightSoft}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <controls:Icon Geometry="{StaticResource IconLock}" Width="16" Height="16"
                                       Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                        <TextBlock Margin="11,0" VerticalAlignment="Center"
                                   Text="Practice. Nothing is read and nothing is marked until you stop." />
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- ══ Status bar ══ -->
            <Border DockPanel.Dock="Bottom" Height="26" Background="{StaticResource SurfaceChrome}"
                    BorderBrush="{StaticResource BorderNightSoft}" BorderThickness="0,1,0,0">
                <DockPanel Margin="14,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ModelStatus" Style="{StaticResource Mono}" FontSize="10.5"
                                   VerticalAlignment="Center" />
                        <Border Width="70" Height="5" Margin="14,0,6,0" CornerRadius="3"
                                VerticalAlignment="Center" Background="{StaticResource SurfaceSunk}"
                                BorderBrush="{StaticResource BorderNightSoft}" BorderThickness="1">
                            <Border x:Name="BudgetFill" HorizontalAlignment="Left" Width="0"
                                    CornerRadius="3" Background="{StaticResource Accent}" />
                        </Border>
                        <TextBlock x:Name="UsageStatus" Style="{StaticResource Mono}" FontSize="10.5"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="PageStatus" Style="{StaticResource Mono}" FontSize="10.5"
                                   Margin="14,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:Icon Geometry="{StaticResource IconCheck}" Width="12" Height="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock x:Name="SaveStatus" Text="Ready" Style="{StaticResource Mono}"
                                   FontSize="10.5" VerticalAlignment="Center" />
                        <controls:Icon x:Name="ConnectivityIcon" Geometry="{StaticResource IconWifi}"
                                       Width="12" Height="12" VerticalAlignment="Center"
                                       Margin="14,0,6,0" />
                        <TextBlock x:Name="ConnectivityStatus" Style="{StaticResource Mono}" FontSize="10.5"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TutorStatus" Style="{StaticResource Mono}" FontSize="10.5"
                                   Margin="14,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentSoft}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ══ Workspace ══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Collapsed by default (edge-to-edge, matching the mockup, which has no
                         nav rail at all) but never removed — NavToggle brings it back. -->
                    <ColumnDefinition x:Name="NavColumn" Width="0" MinWidth="0" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="PageColumn" Width="*" />
                    <ColumnDefinition x:Name="SidebarSplitterColumn" Width="Auto" />
                    <ColumnDefinition x:Name="SidebarColumn" Width="0" MinWidth="0" />
                </Grid.ColumnDefinitions>

                <!-- Navigation rail -->
                <DockPanel Grid.Column="0" Background="{StaticResource AsideWash}">
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderNightSoft}"
                            BorderThickness="0,1,0,0" Padding="8">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AddNotebookButton" Style="{StaticResource IconButton}"
                                    ToolTip="New notebook">
                                <controls:Icon Geometry="{StaticResource IconBookOpen}" Width="15" Height="15"
                                               Foreground="{Binding Foreground,
                                                   RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button x:Name="AddSectionButton" Style="{StaticResource IconButton}"
                                    ToolTip="New section">
                                <controls:Icon Geometry="{StaticResource IconArchive}" Width="15" Height="15"
                                               Foreground="{Binding Foreground,
                                                   RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button x:Name="AddPageButton" Style="{StaticResource IconButton}"
                                    ToolTip="New page">
                                <controls:Icon Geometry="{StaticResource IconFeather}" Width="15" Height="15"
                                               Foreground="{Binding Foreground,
                                                   RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button x:Name="SearchButton" Style="{StaticResource IconButton}"
                                    ToolTip="Find across pages">
                                <controls:Icon Geometry="{StaticResource IconSearch}" Width="15" Height="15"
                                               Foreground="{Binding Foreground,
                                                   RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <TextBlock DockPanel.Dock="Top" Text="NOTEBOOKS" Style="{StaticResource SectionHeader}" />

                    <TreeView x:Name="NavTree" Margin="6,0,4,4">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:NotebookNode}"
                                                      ItemsSource="{Binding Units}">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextTitle}" />
                            </HierarchicalDataTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:UnitNode}"
                                                      ItemsSource="{Binding Sections}">
                                <TextBlock Text="{Binding Name}" FontWeight="Medium"
                                           Foreground="{StaticResource TextMuted}" />
                            </HierarchicalDataTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:SectionNode}"
                                                      ItemsSource="{Binding Pages}">
                                <TextBlock Text="{Binding Name}" />
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type vm:PageNode}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Title}" />
                                    <Border Background="{StaticResource SurfaceSunk}"
                                            CornerRadius="{StaticResource RadiusPill}"
                                            Padding="7,1" Margin="8,0,0,0"
                                            Visibility="{Binding ModeBadge,
                                                Converter={StaticResource EmptyToCollapsed}}">
                                        <TextBlock Text="{Binding ModeBadge}" Style="{StaticResource MicroLabel}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </DockPanel>

                <GridSplitter x:Name="NavSplitter" Grid.Column="1" Width="1"
                              HorizontalAlignment="Stretch" Visibility="Collapsed" />

                <!-- Page area, optionally split into two panes -->
                <Grid Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="SecondPaneColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <controls:InkPageControl x:Name="PageEditor" Grid.Column="0" />

                    <GridSplitter x:Name="PaneSplitter" Grid.Column="1" Width="1"
                                  HorizontalAlignment="Stretch" Visibility="Collapsed" />

                    <controls:InkPageControl x:Name="SecondPage" Grid.Column="2" Visibility="Collapsed" />
                </Grid>

                <GridSplitter x:Name="SidebarSplitter" Grid.Column="3" Width="1"
                              HorizontalAlignment="Stretch" Visibility="Collapsed" />

                <!-- ══ Tutor sidebar ══ -->
                <DockPanel x:Name="Sidebar" Grid.Column="4" Background="{StaticResource AsideWash}"
                           Visibility="Collapsed">
                    <!-- Chat composer -->
                    <Border DockPanel.Dock="Bottom" Padding="14"
                            BorderBrush="{StaticResource BorderNight}" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <Button x:Name="SendButton" DockPanel.Dock="Right"
                                    Style="{StaticResource SendButton}" Margin="8,0,0,0" ToolTip="Ask">
                                <controls:Icon Geometry="{StaticResource IconArrowUp}" Width="17" Height="17"
                                               Thickness="2.4"
                                               Foreground="{Binding Foreground,
                                                   RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <!--
                                The composer is a MathLive field hosted in WebView2 rather than
                                a TextBox: typing "^" or "/" has to build a real superscript or
                                fraction, which no WPF text control can lay out. Its own
                                placeholder lives in the page, so the WPF TextBlock that used to
                                sit behind the TextBox is gone with it.
                            -->
                            <Border Background="{StaticResource SurfaceSunk}"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    BorderBrush="{StaticResource BorderNightSoft}" BorderThickness="1">
                                <!-- Height is driven from the page (see OnComposerMessage): the strip grows when a
                                     typeset preview appears above the box and shrinks back when it goes. -->
                                <wv2:WebView2 x:Name="ChatInputView" Height="38" MinHeight="38" MaxHeight="190"
                                              DefaultBackgroundColor="Transparent" />
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- Summary -->
                    <Border DockPanel.Dock="Top" Padding="16,14,16,14"
                            BorderBrush="{StaticResource BorderNightSoft}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock x:Name="SidebarHeading" Text="WHERE YOU ARE"
                                       Style="{StaticResource MicroLabel}" />
                            <TextBlock x:Name="SidebarSummary" Style="{StaticResource Body}"
                                       Margin="0,8,0,0"
                                       Text="Write something and he'll take a look." />

                            <!-- Review's progress lives here, in the space the topic name used
                                 to fill: the name is already in the crumb at the top left, so
                                 repeating it spent the most visible block in the panel on
                                 something the student had just read.

                                 Two bars, not one. The gate needs problems AND skills, and a
                                 single averaged bar could sit near full while one of them was
                                 at zero. Each owns half the width and neither can spill into
                                 the other's half, so the shape of what is missing is legible
                                 without reading the caption. -->
                            <StackPanel x:Name="UnlockBlock" Visibility="Collapsed">
                                <TextBlock Text="UNLOCKING THE REPORT"
                                           Style="{StaticResource MicroLabel}" />
                                <Border Height="7" CornerRadius="4" Margin="0,9,0,0"
                                        Background="{StaticResource SurfaceSunk}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Margin="0,0,1,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="ProblemsFill" Width="0*" />
                                                <ColumnDefinition x:Name="ProblemsGap" Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="4"
                                                    Background="{StaticResource Accent}" />
                                        </Grid>

                                        <Grid Grid.Column="1" Margin="1,0,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="SkillsFill" Width="0*" />
                                                <ColumnDefinition x:Name="SkillsGap" Width="1*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" CornerRadius="4"
                                                    Background="{StaticResource Success}" />
                                        </Grid>
                                    </Grid>
                                </Border>

                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                           TextWrapping="Wrap">
                                    <Run x:Name="ProblemsDone" /><Run x:Name="ProblemsOf" /><Run
                                        x:Name="SkillsDone" /><Run x:Name="SkillsOf" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel x:Name="SeverityPills" Orientation="Horizontal" Margin="0,10,0,0"
                                        Visibility="Collapsed">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{StaticResource Major}" />
                                <TextBlock x:Name="MajorCount" Margin="6,0,14,0" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{StaticResource Minor}" />
                                <TextBlock x:Name="MinorCount" Margin="6,0,0,0" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Sized from code: in Review with no conversation yet the panel
                                 takes the whole sidebar and the transcript takes none, so the
                                 meters are not squeezed under a 300px ceiling. See
                                 ApplySidebarLayout. -->
                            <RowDefinition x:Name="PanelRow" Height="Auto" MaxHeight="300" />
                            <!-- The unlock bar sits in its own row so it stays against the top of
                                 the chat, wherever the panel above it happens to end. -->
                            <RowDefinition Height="Auto" />
                            <RowDefinition x:Name="ChatRow" Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Findings. Collapsed entirely when page checking is off: with
                             nothing able to produce a finding, both the list and its empty
                             state are dead weight, and an empty state that explains why is
                             just a permanent notice about a setting the student chose. -->
                        <Grid x:Name="FindingsPanel" Grid.Row="0">
                            <ListBox x:Name="FeedbackList" Margin="8,4">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,9,4,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Width="19" Height="19" CornerRadius="10"
                                                    VerticalAlignment="Top" Margin="0,1,10,0"
                                                    Background="{Binding SeverityBrush}">
                                                <TextBlock Text="{Binding Number}" FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource TextOnStar}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <StackPanel Grid.Column="1">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right"
                                                               Text="{Binding Location}"
                                                               Style="{StaticResource Mono}" FontSize="10" />
                                                    <TextBlock Text="{Binding SeverityLabel}"
                                                               Style="{StaticResource MicroLabel}"
                                                               Foreground="{Binding SeverityBrush}" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Subtitle}"
                                                           TextWrapping="Wrap" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel x:Name="NoFeedbackHint" HorizontalAlignment="Center"
                                        Margin="0,30,0,0">
                                <TextBlock x:Name="NoFeedbackTitle" Text="Nothing to flag."
                                           Style="{StaticResource Title}"
                                           FontSize="{StaticResource TextMd}"
                                           HorizontalAlignment="Center" />
                                <!-- Reworded at runtime when page checking is off: claiming to
                                     watch a page nobody is looking at is the one thing this
                                     panel must not do. -->
                                <TextBlock x:Name="NoFeedbackHintText" Text="he's watching the page"
                                           Style="{StaticResource Marginalia}" FontSize="15"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"
                                           TextWrapping="Wrap" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- Review. Occupies the same slot as the findings list and is mutually
                             exclusive with it: page checking produces marks on a page, Review
                             reports a topic's standing over weeks, and only one of the two is
                             ever the answer to "what is this sidebar for right now". Every number
                             comes from SkillConfidence over rows already on disk — opening this
                             costs nothing. -->
                        <Grid x:Name="ReviewPanel" Grid.Row="0" Visibility="Collapsed">
                            <!-- ItemsControl, not ListBox: a row here is a readout, and nothing
                                 responds to picking one. A ListBox still painted a selection
                                 behind whichever row was last clicked, which reads as "this one
                                 is chosen" in a panel where that means nothing. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                            <ItemsControl x:Name="SkillList" Margin="8,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,8,4,10">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding Recency}"
                                                           Style="{StaticResource Mono}" FontSize="10"
                                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                                                <TextBlock Text="{Binding Skill}"
                                                           Style="{StaticResource Subtitle}"
                                                           TextWrapping="Wrap" />
                                            </DockPanel>

                                            <ProgressBar Style="{StaticResource Meter}"
                                                         Value="{Binding Fill, Mode=OneWay}"
                                                         Foreground="{Binding MeterBrush}"
                                                         Margin="0,7,0,0" />

                                            <DockPanel Margin="0,5,0,0">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding TrendLabel}"
                                                           Foreground="{Binding TrendBrush}"
                                                           Style="{StaticResource MicroLabel}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Counts}"
                                                           Style="{StaticResource Caption}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- The meters come first and the report after, because the meters
                                 are free and always there while the report is a thing you choose
                                 to buy. Under the old order a long report pushed every meter
                                 below the fold, so opening Review showed no standings at all. -->
                            <Border x:Name="ReportCard" Visibility="Collapsed"
                                    Margin="8,6,8,2" Padding="12,10"
                                    Background="{StaticResource SurfaceSunk}"
                                    CornerRadius="{StaticResource RadiusSm}">
                                <StackPanel>
                                    <TextBlock Text="WHAT THIS ADDS UP TO"
                                               Style="{StaticResource MicroLabel}" />
                                    <TextBlock x:Name="ReportText" Style="{StaticResource Body}"
                                               Margin="0,7,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="ReportStamp" Style="{StaticResource Caption}"
                                               Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Writing a report is the only thing in Review that spends, so it
                                 is a button rather than a side effect of opening the panel. -->
                            <Button x:Name="ReportButton" Visibility="Collapsed"
                                    Margin="8,6,8,2" Padding="12,8"
                                    HorizontalAlignment="Stretch"
                                    Content="Write the report" />

                            </StackPanel>
                            </ScrollViewer>

                            <!-- Said plainly rather than shown as empty meters: a bar drawn from
                                 one answer invites a study decision it cannot support. -->
                            <StackPanel x:Name="ReviewEmptyHint" HorizontalAlignment="Center"
                                        Margin="0,30,0,0" Visibility="Collapsed">
                                <TextBlock Text="Not enough yet."
                                           Style="{StaticResource Title}"
                                           FontSize="{StaticResource TextMd}"
                                           HorizontalAlignment="Center" />
                                <TextBlock x:Name="ReviewEmptyText"
                                           Style="{StaticResource Marginalia}" FontSize="15"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"
                                           TextWrapping="Wrap" TextAlignment="Center"
                                           Text="ask him about your working and this fills in" />
                            </StackPanel>

                        </Grid>

                        <!-- Chat — a WebView2 surface (not a plain WPF ItemsControl) so replies can
                             carry real typeset math via KaTeX, not just Unicode approximations.
                             Content is loaded from a virtual host mapped to Assets/chat on disk
                             (MainWindow.xaml.cs) — no CDN, works fully offline. -->
                        <!-- How close the topic is to earning a written report, and gone the
                             moment it unlocks: a bar sitting at 100% forever is a permanent
                             reminder of a threshold that no longer applies. The meters above are
                             free and always shown — this measures only the part that costs. -->

                        <wv2:WebView2 x:Name="ChatWebView" Grid.Row="2"
                                      DefaultBackgroundColor="#1E2739" />

                        <!-- Practice seals the panel: three findings held back, nothing sent. -->
                        <Border x:Name="SealedCard" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed"
                                Style="{StaticResource Card}" Margin="18,28" VerticalAlignment="Top"
                                Padding="22,28">
                            <StackPanel HorizontalAlignment="Center">
                                <controls:Icon Geometry="{StaticResource IconLock}" Width="26" Height="26"
                                               Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center" />
                                <TextBlock Text="Sealed until you stop." Style="{StaticResource Title}"
                                           FontSize="{StaticResource TextMd}" Margin="0,13,0,0"
                                           HorizontalAlignment="Center" TextAlignment="Center" />
                                <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0"
                                           TextAlignment="Center"
                                           Text="Nothing is sent and nothing is marked while Practice is on." />
                                <Button x:Name="EndPracticeButton" Content="End practice" Margin="0,16,0,0"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource SurfaceHover}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>

                <!-- The landing view. OneNote's File tab is the model: the same window swaps
                     what it is showing rather than opening a second one, so choosing a lesson
                     and returning to the page you were on are the same gesture in reverse.
                     Spans every column because it covers the body, while the title bar and
                     toolbar above stay live — which is what keeps Home a toggle, not a trap. -->
                <Grid x:Name="HomeHost" Grid.Column="0" Grid.ColumnSpan="5"
                      Background="{StaticResource SurfaceChrome}" Visibility="Collapsed" />
            </Grid>
        </DockPanel>
    </Border>
</Window>
